    <item>
      <title>`{rutera}`: un paquete de R para limpiar y procesar RUTs chilenos</title>
      <link>https://bastianolea.rbind.io/blog/rutera/</link>
      <pubDate>Thu, 18 Jun 2026 00:00:00 +0000</pubDate>
