{{- $pagesIndex := slice -}}
{{- range .Site.Pages -}}
  {{- if in (slice "post" "blog" "tutoriales") .Type -}}
    {{- if gt (len .Content) 0 -}}
      {{- $pageData := dict "title" .Title "href" .Permalink "date" .Params.Date "tags" (delimit (default (slice) .Params.tags) " ; ") "excerpt" (default .Summary .Params.excerpt) "content" (.Plain | truncate 2000) -}}
      {{- $pagesIndex = $pagesIndex | append $pageData -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $pagesIndex | jsonify -}}
